package view

import (
	"strconv"

	"github.com/jayleaton/ai-patterns-go/apps/admin/ui/i18n"
)

// AuthShell centers a narrow auth card, like the original login/signup pages.
templ AuthShell() {
	<div class="min-h-screen flex items-center justify-center bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
		<div class="w-full max-w-md space-y-8 px-4">
			{ children... }
		</div>
	</div>
}

// AuthHeading is the centered page title with an optional description.
templ AuthHeading(title, description string) {
	<div class="text-center">
		<h2 class={ HeadingClass }>{ title }</h2>
		if description != "" {
			<p class={ SubheadingClass }>{ description }</p>
		}
	</div>
}

// Input renders a labelled input, required unless f.Optional.
templ Input(f Field) {
	<div>
		<label for={ f.ID } class={ labelClass }>{ f.Label }</label>
		<input
			id={ f.ID }
			name={ f.ID }
			type={ f.Type }
			autocomplete={ f.Autocomplete }
			if !f.Optional {
				required
			}
			if f.Inputmode != "" {
				inputmode={ f.Inputmode }
			}
			if f.MinLength > 0 {
				minlength={ strconv.Itoa(f.MinLength) }
			}
			class={ inputClass }
			placeholder={ f.Placeholder }
			value={ f.Value }
		/>
		if f.Hint != "" {
			<p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{ f.Hint }</p>
		}
	</div>
}

// SubmitButton swaps its label while the form's Datastar indicator is on.
// signal is the indicator name without "$" (for example "_loading").
templ SubmitButton(label, loadingLabel, signal string) {
	<button type="submit" class={ PrimaryButtonClass } data-attr:disabled={ "$" + signal }>
		<span data-show={ "!$" + signal }>{ label }</span>
		<span style="display: none" data-show={ "$" + signal }>{ loadingLabel }</span>
	</button>
}

// Alert is a patch target: handlers replace it by id with a message, or with
// an empty (hidden) slot to clear it. role is "alert" for errors, "status"
// for confirmations.
templ Alert(id, role, class, message string) {
	if message == "" {
		<div id={ id } class="hidden"></div>
	} else {
		<div id={ id } role={ role } class={ class }>{ message }</div>
	}
}

// ErrorAlert is Alert in the red style used by every form.
templ ErrorAlert(id, message string) {
	@Alert(id, "alert", ErrorAlertClass, message)
}

// InfoBox is the blue "i" note from the forgot-password and verify-email pages.
templ InfoBox(message string) {
	<div class="rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-blue-900 dark:bg-blue-950/40">
		<div class="flex">
			<div class="flex-shrink-0">
				<svg class="h-5 w-5 text-blue-500 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
				</svg>
			</div>
			<div class="ml-3">
				<p class="text-sm text-blue-700 dark:text-blue-300">{ message }</p>
			</div>
		</div>
	</div>
}

// StatusIcon is the round badge above auth headings.
// kind: "success", "warning", "error" or "loading".
templ StatusIcon(kind string) {
	switch kind {
		case "success":
			<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-500/20">
				<svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
			</div>
		case "warning", "error":
			<div
				class={ "mx-auto flex h-12 w-12 items-center justify-center rounded-full",
				templ.KV("bg-yellow-100 dark:bg-yellow-500/20", kind == "warning"),
				templ.KV("bg-red-100 dark:bg-red-500/20", kind == "error") }
			>
				<svg
					class={ "h-6 w-6",
						templ.KV("text-yellow-600 dark:text-yellow-400", kind == "warning"),
						templ.KV("text-red-600 dark:text-red-400", kind == "error") }
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
				</svg>
			</div>
		default:
			<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-500/20">
				<svg class="h-6 w-6 animate-spin text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" aria-hidden="true">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</div>
	}
}

// Option is one <option> of a Select.
type Option struct {
	Value, Label string
}

// Select renders a labelled <select>; selected is the current value.
templ Select(id, label string, options []Option, selected string) {
	<div>
		<label for={ id } class={ labelClass }>{ label }</label>
		<select id={ id } name={ id } class={ inputClass }>
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == selected }>{ o.Label }</option>
			}
		</select>
	</div>
}

// Badge is a small pill; tone is "green", "red", "amber" or "neutral".
templ Badge(tone, label string) {
	<span
		class={ "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
			templ.KV("bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300", tone == "green"),
			templ.KV("bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300", tone == "red"),
			templ.KV("bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300", tone == "amber"),
			templ.KV("bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300", tone != "green" && tone != "red" && tone != "amber") }
	>{ label }</span>
}

// PageHeader is the title row of a dashboard page.
templ PageHeader(title, subtitle string) {
	<div class="mb-6">
		<h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-50">{ title }</h1>
		if subtitle != "" {
			<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{ subtitle }</p>
		}
	</div>
}

// Pager is the pagination row of a list: "showing x-y of N" plus prev/next
// links (empty URL: disabled).
type Pager struct {
	From, To, Total int
	PrevURL, NextURL string
}

// Pagination renders a Pager. summary is the already translated
// "showing x-y of N" text.
templ Pagination(p Pager, summary string) {
	<div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-neutral-600 dark:text-neutral-400">
		<p data-testid="pager-summary">{ summary }</p>
		<div class="flex gap-2">
			@pagerLink(p.PrevURL, i18n.T(ctx, "components.pager.previous"))
			@pagerLink(p.NextURL, i18n.T(ctx, "components.pager.next"))
		</div>
	</div>
}

templ pagerLink(href, label string) {
	if href == "" {
		<span aria-disabled="true" class={ SecondaryButtonClass, "cursor-not-allowed opacity-50" }>{ label }</span>
	} else {
		<a href={ templ.SafeURL(href) } class={ SecondaryButtonClass }>{ label }</a>
	}
}
