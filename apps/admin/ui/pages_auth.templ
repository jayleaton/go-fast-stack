package ui

import (
	"github.com/jayleaton/ai-patterns-go/apps/admin/internal/config"
	"github.com/jayleaton/ai-patterns-go/apps/admin/ui/i18n"
	"github.com/jayleaton/ai-patterns-go/apps/admin/ui/routes"
	"github.com/jayleaton/ai-patterns-go/apps/admin/ui/view"
	"github.com/jayleaton/ai-patterns-go/packages/uikit"
)

// Patch target ids shared by pages and handlers.
const (
	formErrorID      = "form-error"
	twoFactorSetupID = "two-factor-setup"
)

// AuthForm is the state a server-rendered auth form comes back with.
type AuthForm struct {
	Email string
	// Error is already translated.
	Error string
}

// TwoFactorForm is the state of the second sign-in step.
type TwoFactorForm struct {
	Backup bool // a backup code instead of the authenticator app
	Trust  bool
	Error  string
	// Expired: the challenge is gone, so the only way on is signing in again.
	Expired bool
}

// SetupState is the TOTP enrolment page's state; see twoFactorSetupPage.
type SetupState struct {
	SignedIn bool
	Enabled  bool // signed in and 2FA already on
	Required bool // enrolment is mandatory (signed out challenge or ADMIN_REQUIRE_2FA)
	// Setup is the secret to show with the code form; BackupCodes only on
	// the first render.
	Setup   *TOTPSetup
	Expired bool // the SetupRequired challenge is gone
	Done    bool // confirmed while signed in
	Error   string
}

templ LoginPage(f AuthForm) {
	@view.Layout(i18n.T(ctx, "pages.login.title")) {
		@uikit.AuthLayout(view.AppName(ctx), i18n.T(ctx, "pages.login.title"), i18n.T(ctx, "pages.login.description")) {
			<form id="login-form" class="space-y-5" method="post" action={ templ.SafeURL(config.AppRoutes.Login) } data-on:submit={ uikit.PostForm(config.AppRoutes.Login) } data-indicator:_loading>
				@uikit.Alert(formErrorID, uikit.Error, f.Error)
				@uikit.Input(uikit.Field{ID: "email", Type: "email", Label: i18n.T(ctx, "common.email"), Placeholder: i18n.T(ctx, "pages.login.emailPlaceholder"), Autocomplete: "email", Value: f.Email})
				@uikit.Input(uikit.Field{ID: "password", Type: "password", Label: i18n.T(ctx, "common.password"), Placeholder: i18n.T(ctx, "pages.login.passwordPlaceholder"), Autocomplete: "current-password"})
				@uikit.SubmitButton(uikit.Submit{Label: i18n.T(ctx, "pages.login.loginButton"), Loading: i18n.T(ctx, "common.loading"), Signal: "_loading", ButtonProps: uikit.ButtonProps{Full: true}})
			</form>
			<p class="mt-6 border-t border-border pt-5 text-center text-xs text-muted-foreground text-pretty">{ i18n.T(ctx, "pages.login.inviteOnly") }</p>
		}
	}
}

// SetPasswordPage is where invite links land (?token=).
templ SetPasswordPage(token string, f AuthForm) {
	@view.Layout(i18n.T(ctx, "pages.setPassword.title")) {
		@uikit.AuthLayout(view.AppName(ctx), i18n.T(ctx, "pages.setPassword.title"), i18n.T(ctx, "pages.setPassword.description")) {
			if token == "" {
				<div role="alert">
					@uikit.Callout(uikit.Error, "", i18n.T(ctx, "pages.setPassword.invalidLink"))
				</div>
				@backToLogin()
			} else {
				<form class="space-y-5" method="post" action={ templ.SafeURL(config.AppRoutes.SetPassword) } data-on:submit={ uikit.PostForm(config.AppRoutes.SetPassword) } data-indicator:_loading>
					<input type="hidden" name="token" value={ token }/>
					@uikit.Alert(formErrorID, uikit.Error, f.Error)
					@uikit.Input(uikit.Field{ID: "password", Type: "password", Label: i18n.T(ctx, "pages.setPassword.newPassword"), Placeholder: i18n.T(ctx, "pages.setPassword.newPasswordPlaceholder"), Autocomplete: "new-password", MinLength: 8, Hint: i18n.T(ctx, "pages.setPassword.passwordRequirement")})
					@uikit.Input(uikit.Field{ID: "confirmPassword", Type: "password", Label: i18n.T(ctx, "pages.setPassword.confirmPassword"), Placeholder: i18n.T(ctx, "pages.setPassword.confirmPasswordPlaceholder"), Autocomplete: "new-password", MinLength: 8})
					@uikit.SubmitButton(uikit.Submit{Label: i18n.T(ctx, "pages.setPassword.submit"), Loading: i18n.T(ctx, "pages.setPassword.saving"), Signal: "_loading", ButtonProps: uikit.ButtonProps{Full: true}})
				</form>
			}
		}
	}
}

// backToLogin is the centered link back to the sign-in page.
templ backToLogin() {
	<p class="mt-6 text-center text-sm">
		<a href={ templ.SafeURL(config.AppRoutes.Login) } class={ uikit.LinkClass }>{ i18n.T(ctx, "common.backToLogin") }</a>
	</p>
}

// TwoFactorPage is the second sign-in step. The backup-code toggle is a real
// checkbox (method=backup_code), so it works without JS; with JS it also
// swaps the label and keyboard.
templ TwoFactorPage(f TwoFactorForm) {
	@view.Layout(i18n.T(ctx, "pages.twoFactor.title")) {
		@uikit.AuthLayout(view.AppName(ctx), i18n.T(ctx, "pages.twoFactor.title"), i18n.T(ctx, "pages.twoFactor.description")) {
			<form class="space-y-5" method="post" action={ templ.SafeURL(config.AppRoutes.TwoFactor) } data-on:submit={ uikit.PostForm(config.AppRoutes.TwoFactor) } data-indicator:_loading data-signals={ backupSignals(f.Backup) }>
				@TwoFactorError(f)
				<div>
					<label for="code" class={ uikit.LabelClass }>
						<span class={ templ.KV("hidden", f.Backup) } data-class:hidden="$_backup">{ i18n.T(ctx, "pages.twoFactor.codeLabel") }</span>
						<span class={ templ.KV("hidden", !f.Backup) } data-class:hidden="!$_backup">{ i18n.T(ctx, "pages.twoFactor.backupCodeLabel") }</span>
					</label>
					<input id="code" name="code" type="text" required autocomplete="one-time-code" inputmode={ codeInputmode(f.Backup) } data-attr:inputmode="$_backup ? 'text' : 'numeric'" class={ uikit.InputClass, "mt-1.5 h-11 text-center font-mono text-lg tracking-[0.3em] placeholder:tracking-[0.3em]" } placeholder="123456"/>
				</div>
				<div class="space-y-3">
					@uikit.CheckboxField(uikit.Checkbox{ID: "method", Name: "method", Value: MethodBackupCode, Label: i18n.T(ctx, "pages.twoFactor.useBackupCode"), Checked: f.Backup, Attrs: templ.Attributes{"data-on:change": "$_backup = el.checked"}})
					@uikit.CheckboxField(uikit.Checkbox{ID: "trustDevice", Name: "trustDevice", Value: "true", Label: i18n.T(ctx, "pages.twoFactor.trustDevice"), Checked: f.Trust})
				</div>
				@uikit.SubmitButton(uikit.Submit{Label: i18n.T(ctx, "pages.twoFactor.verify"), Loading: i18n.T(ctx, "pages.twoFactor.verifying"), Signal: "_loading", ButtonProps: uikit.ButtonProps{Full: true}})
			</form>
			@backToLogin()
		}
	}
}

// TwoFactorError is the patch target for second-step errors. An expired
// challenge links back to sign in.
templ TwoFactorError(f TwoFactorForm) {
	if f.Expired {
		<div id={ formErrorID } role="alert">
			@uikit.Callout(uikit.Error, "", f.Error) {
				<p><a href={ templ.SafeURL(config.AppRoutes.Login) } class="font-medium underline underline-offset-4">{ i18n.T(ctx, "common.backToLogin") }</a></p>
			}
		</div>
	} else {
		@uikit.Alert(formErrorID, uikit.Error, f.Error)
	}
}

templ TwoFactorSetupPage(s SetupState) {
	@view.Layout(i18n.T(ctx, "pages.twoFactorSetup.title")) {
		@uikit.AuthLayout(view.AppName(ctx), i18n.T(ctx, "pages.twoFactorSetup.title"), "") {
			@SetupBody(s)
		}
	}
}

// SetupBody is the patch target of every enrolment step.
templ SetupBody(s SetupState) {
	<div id={ twoFactorSetupID } class="space-y-5">
		if s.Done || (s.SignedIn && s.Enabled) {
			<div class="text-center">
				@uikit.StatusIcon(uikit.Success)
				<p role="status" class="mt-4 text-sm text-foreground">
					if s.Done {
						{ i18n.T(ctx, "pages.twoFactorSetup.done") }
					} else {
						{ i18n.T(ctx, "pages.twoFactorSetup.alreadyOn") }
					}
				</p>
				<div class="mt-6">
					@uikit.LinkButton(config.AppRoutes.Users, uikit.ButtonProps{Full: true}) {
						{ i18n.T(ctx, "common.continue") }
					}
				</div>
			</div>
		} else if s.Expired {
			<div role="alert">
				@uikit.Callout(uikit.Error, "", firstNonEmpty(s.Error, i18n.T(ctx, "errors.challengeExpired")))
			</div>
			@backToLogin()
		} else if s.Setup != nil {
			if s.Required {
				@uikit.Callout(uikit.Warning, "", i18n.T(ctx, "pages.twoFactorSetup.required"))
			}
			@setupSecret(*s.Setup)
			<form class="space-y-5 border-t border-border pt-5" method="post" action={ templ.SafeURL(config.AppRoutes.TwoFactorSetup) } data-on:submit={ uikit.PostForm(config.AppRoutes.TwoFactorSetup) } data-indicator:_verifying>
				<input type="hidden" name="secret" value={ s.Setup.Secret }/>
				<input type="hidden" name="uri" value={ s.Setup.URI }/>
				@uikit.Alert(formErrorID, uikit.Error, s.Error)
				@uikit.Input(uikit.Field{ID: "code", Label: i18n.T(ctx, "pages.twoFactorSetup.codeLabel"), Placeholder: "123456", Autocomplete: "one-time-code", Inputmode: "numeric"})
				@uikit.SubmitButton(uikit.Submit{Label: i18n.T(ctx, "pages.twoFactorSetup.confirm"), Loading: i18n.T(ctx, "pages.twoFactor.verifying"), Signal: "_verifying", ButtonProps: uikit.ButtonProps{Full: true}})
			</form>
		} else {
			if s.Required {
				@uikit.Callout(uikit.Warning, "", i18n.T(ctx, "pages.twoFactorSetup.required"))
			}
			<p class="text-sm text-muted-foreground text-pretty">{ i18n.T(ctx, "pages.twoFactorSetup.description") }</p>
			<form class="space-y-5" method="post" action={ templ.SafeURL(routes.EnableTwoFactor) } data-on:submit={ uikit.PostForm(routes.EnableTwoFactor) } data-indicator:_enabling>
				@uikit.Alert(formErrorID, uikit.Error, s.Error)
				@uikit.Input(uikit.Field{ID: "password", Type: "password", Label: i18n.T(ctx, "pages.twoFactorSetup.passwordLabel"), Autocomplete: "current-password"})
				@uikit.SubmitButton(uikit.Submit{Label: i18n.T(ctx, "pages.twoFactorSetup.start"), Loading: i18n.T(ctx, "common.loading"), Signal: "_enabling", ButtonProps: uikit.ButtonProps{Full: true}})
			</form>
		}
	</div>
}

// setupSecret shows how to add the account to an authenticator app: the QR
// code, the open-in-app link, the key to type in, and the backup codes.
templ setupSecret(t TOTPSetup) {
	<div class="space-y-5 text-sm">
		<p class="text-muted-foreground text-pretty">{ i18n.T(ctx, "pages.twoFactorSetup.scan") }</p>
		if q, ok := totpQR(t.URI); ok {
			@qrCode(q)
		}
		if href := otpLink(t.URI); href != "" {
			<p class="text-center">
				@uikit.LinkButton(href, uikit.ButtonProps{Variant: uikit.Secondary, Size: uikit.Small}) {
					{ i18n.T(ctx, "pages.twoFactorSetup.openApp") }
				}
			</p>
		}
		<div>
			<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "pages.twoFactorSetup.manualEntry") }</p>
			<p data-testid="totp-secret" class="mt-1.5 select-all rounded-control border border-border bg-muted px-3 py-2.5 text-center font-mono text-base tracking-wider break-all text-foreground">{ groupSecret(t.Secret) }</p>
		</div>
		if len(t.BackupCodes) > 0 {
			@uikit.Callout(uikit.Warning, i18n.T(ctx, "pages.twoFactorSetup.backupCodes"), i18n.T(ctx, "pages.twoFactorSetup.backupCodesHint")) {
				<ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 font-mono text-sm">
					for _, c := range t.BackupCodes {
						<li>{ c }</li>
					}
				</ul>
			}
		}
	</div>
}

// qrCode is the TOTP QR code as an inline SVG. The white background (on
// purpose, not a theme token) keeps it scannable in dark mode.
templ qrCode(q QRCode) {
	<div class="mx-auto w-fit rounded-card border border-border bg-white p-3 shadow-card">
		<svg xmlns="http://www.w3.org/2000/svg" data-testid="totp-qr" viewBox={ q.ViewBox() } width="192" height="192" class="block size-48" shape-rendering="crispEdges" role="img" aria-label={ i18n.T(ctx, "pages.twoFactorSetup.qrLabel") }>
			<rect width="100%" height="100%" fill="#fff"></rect>
			<path d={ q.Path } fill="#000"></path>
		</svg>
	</div>
}
