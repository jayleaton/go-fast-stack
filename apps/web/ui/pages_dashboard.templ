package ui

import (
	"net/url"
	"time"

	"github.com/jayleaton/ai-patterns-go/apps/web/ui/i18n"
	"github.com/jayleaton/ai-patterns-go/apps/web/internal/config"
	"github.com/jayleaton/ai-patterns-go/apps/web/ui/routes"
	"github.com/jayleaton/ai-patterns-go/apps/web/ui/view"
)

const (
	accountCardID    = "account-card"
	liveBodyID       = "live-body"
	liveNoticeID     = "live-notice"
)

const cardClass = "rounded-xl border border-neutral-300 bg-white shadow-sm dark:border-neutral-800 dark:bg-neutral-900/80"

// DashboardData is everything the dashboard renders.
type DashboardData struct {
	User User
	// Tab identifies this page load so the live stream can tell profile saves
	// made in this tab from saves made elsewhere.
	Tab string
}

templ DashboardPage(d DashboardData) {
	@view.Layout(i18n.T(ctx, "pages.dashboard.title")) {
		<div class="container-balanced py-8 md:py-20">
			<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-50">{ i18n.T(ctx, "pages.dashboard.title") }</h1>
					<p class="text-sm text-neutral-600 dark:text-neutral-400">{ i18n.T(ctx, "pages.dashboard.subtitle") }</p>
				</div>
				<div class="flex items-center gap-2">
					<a href={ templ.SafeURL(config.AppRoutes.Home) } class="rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800">
						{ i18n.T(ctx, "common.home") }
					</a>
				</div>
			</div>
			<section class="grid grid-cols-1 gap-6 md:grid-cols-3">
				@AccountCard(d.User)
				<div class={ "col-span-1 p-5", cardClass }>
					<h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{ i18n.T(ctx, "pages.dashboard.quickActions.title") }</h2>
					<div class="mt-4 flex flex-wrap gap-2">
						<a href={ templ.SafeURL(config.AppRoutes.Account) } class="rounded-md border border-blue-300 bg-blue-50 px-3 py-2 text-sm text-blue-800 hover:bg-blue-100 dark:border-blue-800 dark:bg-blue-900/30 dark:text-blue-200 dark:hover:bg-blue-900/50">
							{ i18n.T(ctx, "pages.dashboard.quickActions.settings") }
						</a>
						<button type="button" class="rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-800 hover:bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
							{ i18n.T(ctx, "pages.dashboard.quickActions.profile") }
						</button>
						<button type="button" class="rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-800 hover:bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-200">
							{ i18n.T(ctx, "pages.dashboard.quickActions.support") }
						</button>
					</div>
				</div>
				@LiveCard(d.Tab)
			</section>
			<section class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				<div class={ "p-6", cardClass }>
					<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{ i18n.T(ctx, "pages.dashboard.sections.analytics.title") }</h3>
					<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{ i18n.T(ctx, "pages.dashboard.sections.analytics.description") }</p>
					<div class="mt-4 h-24 rounded-lg bg-neutral-100 dark:bg-neutral-800"></div>
				</div>
				<div class={ "p-6", cardClass }>
					<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{ i18n.T(ctx, "pages.dashboard.sections.activity.title") }</h3>
					<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{ i18n.T(ctx, "pages.dashboard.sections.activity.description") }</p>
					<div class="mt-4 space-y-2">
						<div class="h-4 rounded bg-neutral-100 dark:bg-neutral-800"></div>
						<div class="h-4 w-3/4 rounded bg-neutral-100 dark:bg-neutral-800"></div>
						<div class="h-4 w-1/2 rounded bg-neutral-100 dark:bg-neutral-800"></div>
					</div>
				</div>
				<div class={ "p-6", cardClass }>
					<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{ i18n.T(ctx, "pages.dashboard.sections.settings.title") }</h3>
					<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{ i18n.T(ctx, "pages.dashboard.sections.settings.description") }</p>
					<div class="mt-4 flex gap-2">
						<div class="h-8 w-16 rounded bg-neutral-100 dark:bg-neutral-800"></div>
						<div class="h-8 w-20 rounded bg-neutral-100 dark:bg-neutral-800"></div>
					</div>
				</div>
			</section>
		</div>
	}
}

// AccountCard is components/dashboard/UserCard.tsx; the settings save and the
// live stream patch it in place.
templ AccountCard(u User) {
	<div id={ accountCardID } class={ "col-span-1 p-5", cardClass }>
		<h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{ i18n.T(ctx, "pages.dashboard.account") }</h2>
		<div class="mt-3 text-sm text-neutral-700 dark:text-neutral-300">
			<div class="space-y-1">
				<p><span class="text-neutral-500">{ i18n.T(ctx, "common.name") }:</span> <span data-testid="account-name">{ orDash(u.Name) }</span></p>
				<p><span class="text-neutral-500">{ i18n.T(ctx, "common.email") }:</span> <span data-testid="account-email">{ orDash(u.Email) }</span></p>
				<p><span class="text-neutral-500">{ i18n.T(ctx, "pages.dashboard.memberSince") }:</span> { memberSince(ctx, u.CreatedAt) }</p>
				<div class="mt-3 inline-flex items-center gap-2 rounded-md border border-emerald-300 bg-emerald-50 px-2 py-1 text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-900/30 dark:text-emerald-300">
					<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
					{ i18n.T(ctx, "pages.dashboard.subscriptionActive") }
				</div>
			</div>
		</div>
	</div>
}

// LiveCard opens the dashboard SSE stream on load. It shows a skeleton until
// the first event patches #live-body.
templ LiveCard(tab string) {
	<div class={ "col-span-1 p-5", cardClass } data-init={ view.Get(routes.DashboardLive + "?" + url.Values{"tab": {tab}}.Encode()) }>
		<h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{ i18n.T(ctx, "pages.dashboard.live.title") }</h2>
		<p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{ i18n.T(ctx, "pages.dashboard.live.description") }</p>
		<div id={ liveBodyID } class="mt-3">
			@view.LineSkeleton()
		</div>
		<div id={ liveNoticeID } class="hidden"></div>
	</div>
}

// LiveBody is the fragment the stream patches every tick.
templ LiveBody(now time.Time, s Session) {
	<div id={ liveBodyID } class="mt-3 space-y-1 text-sm text-neutral-700 dark:text-neutral-300">
		<p class="inline-flex items-center gap-2 text-xs text-emerald-700 dark:text-emerald-300">
			<span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
			{ i18n.T(ctx, "pages.dashboard.live.connected") }
		</p>
		<p><span class="text-neutral-500">{ i18n.T(ctx, "pages.dashboard.live.serverTime") }:</span> <span data-testid="live-clock" class="font-mono">{ now.UTC().Format("15:04:05") } UTC</span></p>
		if !s.ExpiresAt.IsZero() {
			<p><span class="text-neutral-500">{ i18n.T(ctx, "pages.dashboard.live.sessionExpires") }:</span> { i18n.From(ctx).DateTime(s.ExpiresAt.UTC()) }</p>
		}
	</div>
}

// LiveNotice tells this tab that another tab changed the account.
templ LiveNotice() {
	<div id={ liveNoticeID } role="status" class="mt-3 rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-700 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-300">
		{ i18n.T(ctx, "pages.dashboard.live.updatedElsewhere") }
	</div>
}

// HomePage is "/" when the template welcome is turned off.
templ HomePage() {
	@view.Layout("") {
		<div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-6">
			<h1 class="text-3xl font-semibold tracking-tight text-neutral-950 dark:text-white">{ i18n.T(ctx, "pages.home.title") }</h1>
			<p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-300">{ i18n.T(ctx, "pages.home.body") }</p>
			<div class="mt-8 flex gap-3">
				<a href={ templ.SafeURL(config.AppRoutes.Signup) } class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white">{ i18n.T(ctx, "pages.home.signUp") }</a>
				<a href={ templ.SafeURL(config.AppRoutes.Login) } class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium dark:border-neutral-700">{ i18n.T(ctx, "pages.home.signIn") }</a>
			</div>
		</div>
	}
}
