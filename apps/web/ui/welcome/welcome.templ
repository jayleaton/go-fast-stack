package welcome

import (
	"strconv"

	"github.com/jayleaton/ai-patterns-go/apps/web/internal/config"
	"github.com/jayleaton/ai-patterns-go/apps/web/ui/view"
)

templ shell() {
	<div class="relative min-h-screen bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
		<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.08),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,rgba(96,165,250,0.12),transparent_55%)]"></div>
		<div class="relative mx-auto w-full max-w-3xl px-5 pb-16 pt-8 md:px-6 md:pb-20 md:pt-12">
			{ children... }
		</div>
	</div>
}

templ eyebrow(text string) {
	<p class="text-xs font-medium uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">{ text }</p>
}

templ section(id string) {
	<section
		if id != "" {
			id={ id }
		}
		class="scroll-mt-24 mt-10 border-t border-neutral-200/80 pt-14 pb-14 dark:border-neutral-800 md:mt-12"
	>
		{ children... }
	</section>
}

const (
	cardClass   = "rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900"
	h2Class     = "mt-3 text-2xl font-semibold tracking-tight md:text-3xl"
	leadClass   = "mt-3 max-w-2xl leading-relaxed text-neutral-600 dark:text-neutral-300"
	h3Class     = "font-semibold text-neutral-950 dark:text-white"
	bodyClass   = "text-sm leading-relaxed text-neutral-600 dark:text-neutral-300"
	primaryCTA  = "inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-medium text-white hover:bg-blue-600/90 dark:bg-blue-500 dark:hover:bg-blue-400"
	outlineCTA  = "inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-medium text-neutral-900 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100 dark:hover:bg-neutral-800"
	footerLink  = "hover:text-neutral-900 dark:hover:text-white"
	heroH1Class = "text-[2rem] font-semibold leading-tight tracking-tight text-neutral-950 sm:text-4xl md:text-5xl dark:text-white"
)

// LandingPage is template-welcome/LandingPage.tsx.
templ LandingPage() {
	{{ t := CopyFor(ctx) }}
	@view.Layout("") {
		@shell() {
			<header class="space-y-6 pb-2">
				<p class="inline-flex rounded-full border border-blue-200 bg-white px-3 py-1 text-xs font-medium text-blue-800 dark:border-blue-900 dark:bg-neutral-900 dark:text-blue-200">{ t.Hero.Badge }</p>
				<h1 class={ heroH1Class }>{ t.Hero.Title }</h1>
				<p class="max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-300">{ t.Hero.Subtitle }</p>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
					<a href={ templ.SafeURL(config.AppRoutes.Signup) } class={ primaryCTA }>{ t.Hero.Primary }</a>
					<a href={ templ.SafeURL(config.AppRoutes.Login) } class={ outlineCTA }>{ t.Hero.Secondary }</a>
					<a href="#start" class="inline-flex items-center justify-center px-2 py-3 text-sm font-medium text-neutral-600 underline-offset-4 hover:underline dark:text-neutral-300">{ t.Hero.Skip }</a>
				</div>
			</header>
			@section("") {
				@eyebrow(t.What.Eyebrow)
				<h2 class={ h2Class }>{ t.What.Title }</h2>
				<p class={ leadClass }>{ t.What.Body }</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-3">
					for _, c := range t.What.Cards {
						<li class={ cardClass }>
							<h3 class={ h3Class }>{ c.Title }</h3>
							<p class={ "mt-2", bodyClass }>{ c.Body }</p>
						</li>
					}
				</ul>
			}
			@section("start") {
				@eyebrow(t.Start.Eyebrow)
				<h2 class={ h2Class }>{ t.Start.Title }</h2>
				<p class={ leadClass }>{ t.Start.Subtitle }</p>
				<ol class="mt-8 space-y-3">
					for i, s := range t.Start.Steps {
						<li class={ "flex gap-4", cardClass }>
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-neutral-950 text-sm font-semibold text-white dark:bg-white dark:text-neutral-950">{ strconv.Itoa(i + 1) }</span>
							<div>
								<h3 class={ h3Class }>{ s.Title }</h3>
								<p class={ "mt-1", bodyClass }>{ s.Body }</p>
							</div>
						</li>
					}
				</ol>
			}
			@section("patterns") {
				@eyebrow(t.Patterns.Eyebrow)
				<h2 class={ h2Class }>{ t.Patterns.Title }</h2>
				<p class={ leadClass }>{ t.Patterns.Subtitle }</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					for _, p := range t.Patterns.Items {
						<li class={ cardClass }>
							<h3 class={ h3Class }>{ p.Title }</h3>
							<p class={ "mt-2", bodyClass }>{ p.Body }</p>
							<p class="mt-4 break-all font-mono text-xs text-neutral-500 dark:text-neutral-400">{ p.Path }</p>
						</li>
					}
				</ul>
				<p class="mt-6">
					<a href={ templ.SafeURL(config.AppRoutes.Why) } class="text-sm font-medium text-blue-700 underline-offset-4 hover:underline dark:text-blue-300">{ t.Patterns.More }</a>
				</p>
			}
			@section("") {
				@eyebrow(t.Later.Eyebrow)
				<h2 class={ h2Class }>{ t.Later.Title }</h2>
				<ul class="mt-8 space-y-4">
					for _, it := range t.Later.Items {
						<li>
							<h3 class={ h3Class }>{ it.Title }</h3>
							<p class={ "mt-1", bodyClass }>{ it.Body }</p>
						</li>
					}
				</ul>
			}
			@section("remove") {
				<div class="rounded-2xl border border-dashed border-neutral-400 bg-white p-6 dark:border-neutral-600 dark:bg-neutral-900">
					@eyebrow(t.Remove.Eyebrow)
					<h2 class="mt-3 text-2xl font-semibold tracking-tight">{ t.Remove.Title }</h2>
					<p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-300">{ t.Remove.Body }</p>
					<ol class="mt-6 space-y-3">
						for i, s := range t.Remove.Steps {
							<li class="flex gap-3 text-sm leading-relaxed">
								<span class="font-semibold text-neutral-950 dark:text-white">{ strconv.Itoa(i + 1) }.</span>
								<span class="text-neutral-700 dark:text-neutral-300">{ s }</span>
							</li>
						}
					</ol>
					<p class="mt-5 text-sm text-neutral-500 dark:text-neutral-400">{ t.Remove.Note }</p>
				</div>
			}
			<footer class="mt-10 flex flex-col gap-3 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between dark:text-neutral-400">
				<span>{ t.Footer.Brand }</span>
				<nav class="flex flex-wrap gap-4">
					<a href={ templ.SafeURL(config.AppRoutes.Why) } class={ footerLink }>{ t.Footer.Why }</a>
					<a href={ templ.SafeURL(config.AppRoutes.Login) } class={ footerLink }>{ t.Footer.Login }</a>
					<a href={ templ.SafeURL(config.AppRoutes.Signup) } class={ footerLink }>{ t.Footer.Signup }</a>
				</nav>
			</footer>
		}
	}
}

// WhyPage is template-welcome/WhyPatternsPage.tsx.
templ WhyPage() {
	{{ t := CopyFor(ctx) }}
	@view.Layout(t.Footer.Why) {
		@shell() {
			<header class="space-y-5">
				@eyebrow(t.Why.Eyebrow)
				<h1 class={ heroH1Class }>{ t.Why.Title }</h1>
				<p class="max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">{ t.Why.Subtitle }</p>
			</header>
			<section class="mt-12 rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-900/60 dark:bg-amber-950/30">
				<h2 class="text-lg font-semibold text-amber-950 dark:text-amber-100">{ t.Why.IntroTitle }</h2>
				<p class="mt-2 leading-relaxed text-amber-900 dark:text-amber-100/90">{ t.Why.IntroBody }</p>
			</section>
			<ol class="mt-10 space-y-6">
				for i, it := range t.Why.Items {
					<li class="rounded-2xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
						<p class="text-xs font-medium uppercase tracking-[0.16em] text-neutral-500">{ strconv.Itoa(i + 1) } / { strconv.Itoa(len(t.Why.Items)) }</p>
						<h2 class="mt-2 text-xl font-semibold text-neutral-950 dark:text-white">{ it.Title }</h2>
						<p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-300">{ it.Analogy }</p>
						<p class="mt-4 text-sm leading-relaxed text-neutral-700 dark:text-neutral-200">{ it.LookHere }</p>
						<p class="mt-3 break-all font-mono text-xs text-neutral-500 dark:text-neutral-400">{ it.Path }</p>
					</li>
				}
			</ol>
			<div class="mt-12 flex flex-col gap-3 sm:flex-row">
				<a href={ templ.SafeURL(config.AppRoutes.Home) } class={ outlineCTA }>{ t.Why.Back }</a>
				<a href={ templ.SafeURL(config.AppRoutes.Signup) } class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-medium text-white hover:bg-blue-600/90 dark:bg-blue-500">{ t.Why.Start }</a>
			</div>
		}
	}
}
