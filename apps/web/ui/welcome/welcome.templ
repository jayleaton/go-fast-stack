package welcome

import (
	"strconv"

	"github.com/jayleaton/ai-patterns-go/apps/web/internal/config"
	"github.com/jayleaton/ai-patterns-go/apps/web/ui/view"
	"github.com/jayleaton/ai-patterns-go/packages/uikit"
)

templ shell() {
	<div class="relative isolate">
		<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 bg-gradient-to-b from-accent to-transparent opacity-70"></div>
		<div class="mx-auto w-full max-w-3xl px-4 pb-16 pt-10 sm:px-6 md:pb-20 md:pt-16">
			{ children... }
		</div>
	</div>
}

templ eyebrow(text string) {
	<p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">{ text }</p>
}

templ section(id string) {
	<section
		if id != "" {
			id={ id }
		}
		class="mt-14 scroll-mt-24 border-t border-border pt-14"
	>
		{ children... }
	</section>
}

const (
	cardClass   = uikit.CardClass + " p-5"
	h2Class     = "mt-3 text-2xl font-semibold tracking-tight text-balance md:text-3xl"
	leadClass   = "mt-3 max-w-2xl leading-relaxed text-muted-foreground text-pretty"
	h3Class     = "font-semibold"
	bodyClass   = "text-sm leading-relaxed text-muted-foreground"
	pathClass   = "break-all font-mono text-xs text-muted-foreground"
	numberClass = "grid size-8 shrink-0 place-items-center rounded-full bg-primary text-sm font-semibold text-primary-foreground"
	heroH1Class = "text-[2rem] font-semibold leading-tight tracking-tight text-balance sm:text-4xl md:text-5xl"
	footerLink  = "rounded-control hover:text-foreground"
)

// LandingPage is template-welcome/LandingPage.tsx.
templ LandingPage() {
	{{ t := CopyFor(ctx) }}
	@view.Layout("") {
		@shell() {
			<header class="space-y-6">
				@uikit.Badge(uikit.Brand, t.Hero.Badge, true)
				<h1 class={ heroH1Class }>{ t.Hero.Title }</h1>
				<p class="max-w-2xl text-base leading-relaxed text-muted-foreground text-pretty sm:text-lg">{ t.Hero.Subtitle }</p>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
					@uikit.LinkButton(config.AppRoutes.Signup, uikit.ButtonProps{}) {
						{ t.Hero.Primary }
					}
					@uikit.LinkButton(config.AppRoutes.Login, uikit.ButtonProps{Variant: uikit.Secondary}) {
						{ t.Hero.Secondary }
					}
					@uikit.LinkButton("#start", uikit.ButtonProps{Variant: uikit.Ghost}) {
						{ t.Hero.Skip }
					}
				</div>
			</header>
			@section("") {
				@eyebrow(t.What.Eyebrow)
				<h2 class={ h2Class }>{ t.What.Title }</h2>
				<p class={ leadClass }>{ t.What.Body }</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-3">
					for _, c := range t.What.Cards {
						<li class={ cardClass }>
							<h3 class={ h3Class }>{ c.Title }</h3>
							<p class={ "mt-2", bodyClass }>{ c.Body }</p>
						</li>
					}
				</ul>
			}
			@section("start") {
				@eyebrow(t.Start.Eyebrow)
				<h2 class={ h2Class }>{ t.Start.Title }</h2>
				<p class={ leadClass }>{ t.Start.Subtitle }</p>
				<ol class="mt-8 space-y-3">
					for i, s := range t.Start.Steps {
						<li class={ "flex gap-4", cardClass }>
							<span class={ numberClass } aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
							<div class="min-w-0">
								<h3 class={ h3Class }>{ s.Title }</h3>
								<p class={ "mt-1", bodyClass }>{ s.Body }</p>
							</div>
						</li>
					}
				</ol>
			}
			@section("patterns") {
				@eyebrow(t.Patterns.Eyebrow)
				<h2 class={ h2Class }>{ t.Patterns.Title }</h2>
				<p class={ leadClass }>{ t.Patterns.Subtitle }</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					for _, p := range t.Patterns.Items {
						<li class={ "flex flex-col", cardClass }>
							<h3 class={ h3Class }>{ p.Title }</h3>
							<p class={ "mt-2 flex-1", bodyClass }>{ p.Body }</p>
							<p class={ "mt-4 rounded-control bg-muted px-2.5 py-1.5", pathClass }>{ p.Path }</p>
						</li>
					}
				</ul>
				<p class="mt-6 text-sm">
					<a href={ templ.SafeURL(config.AppRoutes.Why) } class={ uikit.LinkClass }>{ t.Patterns.More } <span aria-hidden="true">→</span></a>
				</p>
			}
			@section("") {
				@eyebrow(t.Later.Eyebrow)
				<h2 class={ h2Class }>{ t.Later.Title }</h2>
				<ul class="mt-8 divide-y divide-border">
					for _, it := range t.Later.Items {
						<li class="py-4 first:pt-0">
							<h3 class={ h3Class }>{ it.Title }</h3>
							<p class={ "mt-1", bodyClass }>{ it.Body }</p>
						</li>
					}
				</ul>
			}
			@section("remove") {
				<div class="rounded-card border border-dashed border-input bg-surface p-6">
					@eyebrow(t.Remove.Eyebrow)
					<h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance">{ t.Remove.Title }</h2>
					<p class="mt-3 leading-relaxed text-muted-foreground">{ t.Remove.Body }</p>
					<ol class="mt-6 space-y-3">
						for i, s := range t.Remove.Steps {
							<li class="flex gap-3 text-sm leading-relaxed">
								<span class="font-semibold">{ strconv.Itoa(i + 1) }.</span>
								<span>{ s }</span>
							</li>
						}
					</ol>
					<p class="mt-5 text-sm text-muted-foreground">{ t.Remove.Note }</p>
				</div>
			}
			<footer class="mt-14 flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
				<span class="font-medium text-foreground">{ view.AppName(view.StateFrom(ctx)) }</span>
				<nav aria-label={ t.Footer.Label } class="flex flex-wrap gap-4">
					<a href={ templ.SafeURL(config.AppRoutes.Why) } class={ footerLink }>{ t.Footer.Why }</a>
					<a href={ templ.SafeURL(config.AppRoutes.Login) } class={ footerLink }>{ t.Footer.Login }</a>
					<a href={ templ.SafeURL(config.AppRoutes.Signup) } class={ footerLink }>{ t.Footer.Signup }</a>
				</nav>
			</footer>
		}
	}
}

// WhyPage is template-welcome/WhyPatternsPage.tsx.
templ WhyPage() {
	{{ t := CopyFor(ctx) }}
	@view.Layout(t.Footer.Why) {
		@shell() {
			<header class="space-y-5">
				@eyebrow(t.Why.Eyebrow)
				<h1 class={ heroH1Class }>{ t.Why.Title }</h1>
				<p class="max-w-2xl text-lg leading-relaxed text-muted-foreground text-pretty">{ t.Why.Subtitle }</p>
			</header>
			<section class="mt-12 rounded-card border border-warning-border bg-warning-soft p-6 text-warning-soft-foreground">
				<h2 class="text-lg font-semibold">{ t.Why.IntroTitle }</h2>
				<p class="mt-2 leading-relaxed">{ t.Why.IntroBody }</p>
			</section>
			<ol class="mt-10 space-y-6">
				for i, it := range t.Why.Items {
					<li class={ uikit.CardClass, "p-6" }>
						<p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{ strconv.Itoa(i + 1) } / { strconv.Itoa(len(t.Why.Items)) }</p>
						<h2 class="mt-2 text-xl font-semibold">{ it.Title }</h2>
						<p class="mt-3 leading-relaxed text-muted-foreground">{ it.Analogy }</p>
						<p class="mt-4 border-l-2 border-primary pl-3 text-sm leading-relaxed">{ it.LookHere }</p>
						<p class={ "mt-4", pathClass }>{ it.Path }</p>
					</li>
				}
			</ol>
			<div class="mt-12 flex flex-col gap-3 sm:flex-row">
				@uikit.LinkButton(config.AppRoutes.Home, uikit.ButtonProps{Variant: uikit.Secondary}) {
					{ t.Why.Back }
				}
				@uikit.LinkButton(config.AppRoutes.Signup, uikit.ButtonProps{}) {
					{ t.Why.Start }
				}
			</div>
		}
	}
}
