# Copied to .env by `make` on first run. .env is gitignored; never commit secrets.

# development | test | production. Production turns on email verification and
# requires RESEND_API_KEY; development logs email links instead of sending.
APP_ENV=development

# Public origin of the app (links in emails, auth callbacks). The server binds
# 0.0.0.0, so set this to the URL people actually use (LAN/Tailscale host is fine).
PUBLIC_URL=http://localhost:3000
# Optional: origin the server uses to reach itself (defaults to PUBLIC_URL).
# INTERNAL_URL=http://127.0.0.1:3000
# Optional: extra origins allowed to call auth endpoints (comma-separated),
# e.g. the mobile app scheme or a Tailscale hostname.
# TRUSTED_ORIGINS=betterstack://,http://dev-box:3000
# Optional: header your proxy sets to the client IP, used for auth rate limits
# (Railway: X-Real-IP). Leave empty without a proxy: clients could spoof it.
# CLIENT_IP_HEADER=X-Real-IP
# Optional: the product name in the UI header and page titles (default "My App").
# APP_NAME=My App
# Optional: listen port (Railway sets it).
# PORT=3000

# Unset: make points it at this checkout's docker compose Postgres (`make env`).
# Hosted Postgres uses ?sslmode=require.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# While rotating: the old value(s), comma-separated, still accepted for
# AUTH_SECRET_GRACE (default: session lifetime, 30 days with 2FA). docs/secrets.md.
# AUTH_SECRET_PREVIOUS=
# A leaked value: never accepted again, only used to unwrap 2FA keys.
# AUTH_SECRET_REVOKED=
# AUTH_SECRET_GRACE=168h

# Required in production. Without it auth emails are logged, not sent.
# With SECRETS_PROVIDER=doppler it comes from Doppler instead (this is ignored).
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# Live secrets (docs/secrets.md): env (default, read once at boot) or doppler
# (polled; RESEND_API_KEY rotates without a restart).
# SECRETS_PROVIDER=doppler
# DOPPLER_TOKEN=dp.st.dev.xxxx         read-only service token for one config
# SECRETS_REFRESH_INTERVAL=60s
# SECRETS_MAX_STALENESS=15m

# make derives a compose project and ports per checkout so parallel worktrees
# never collide; `make env` prints them. Override only if you need fixed values.
# COMPOSE_PROJECT_NAME=myapp
# POSTGRES_PORT=5432
# PGWEB_PORT=5050
# TEST_POSTGRES_PORT=54329   (unset: a free port on every start)

# --- Admin dashboard (apps/admin, optional) ---
# `make admin-dev` serves it on 0.0.0.0:ADMIN_PORT. It reads DATABASE_URL (the
# app's users) and its own ADMIN_DATABASE_URL (admins + audit log; unset: make
# points it at the "admin" database on this checkout's dev Postgres).
ADMIN_PORT=3001
ADMIN_PUBLIC_URL=http://localhost:3001
# At least 32 characters and different from AUTH_SECRET: openssl rand -base64 32
ADMIN_AUTH_SECRET=dev-only-admin-secret-change-me-0123456789
# Rotating: ADMIN_AUTH_SECRET_PREVIOUS / ADMIN_AUTH_SECRET_REVOKED and
# ADMIN_AUTH_SECRET_GRACE work like the app's AUTH_SECRET_* (docs/secrets.md).
# Seeded (without a password) by `make admin-migrate`; then run
# `make admin-invite EMAIL=...` and open the set-password link from the log.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Admins must enrol in TOTP before their first session. Default: on in production.
# ADMIN_REQUIRE_2FA=true
# ADMIN_APP_NAME=Admin
# Admin changes are audited before they run; one whose outcome was never
# recorded is resolved from the current state once it is this old.
# ADMIN_AUDIT_RECONCILE_AFTER=2m
# ADMIN_TRUSTED_ORIGINS=http://dev-box:3001
# ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/admin?sslmode=disable

# Backups (docs/backups.md). make db-backup encrypts with this key
# and stores in .backups/; set BACKUP_S3_* to use an S3-compatible bucket.
BACKUP_ENCRYPTION_KEY=dev-only-backup-key-change-me-0123456789abcdef
# BACKUP_S3_ENDPOINT=https://t3.storageapi.dev
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PATH_STYLE=false
