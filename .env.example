# Copied to .env by `make` on first run. .env is gitignored; never commit secrets.

# development | test | production. Production turns on email verification and
# requires RESEND_API_KEY; development logs email links instead of sending.
APP_ENV=development

# Public origin of the app (links in emails, auth callbacks). The server binds
# 0.0.0.0, so set this to the URL people actually use (LAN/Tailscale host is fine).
PUBLIC_URL=http://localhost:3000
# Optional: origin the server uses to reach itself (defaults to PUBLIC_URL).
# INTERNAL_URL=http://127.0.0.1:3000
# Optional: extra origins allowed to call auth endpoints (comma-separated),
# e.g. the mobile app scheme or a Tailscale hostname.
# TRUSTED_ORIGINS=betterstack://,http://dev-box:3000
# Optional: listen port (Railway sets it).
# PORT=3000

# Local docker compose Postgres. Hosted Postgres uses ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Required in production.
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# Host ports for docker compose (override when taken by other projects).
# POSTGRES_PORT=5432
# PGWEB_PORT=5050
# TEST_POSTGRES_PORT=54329
